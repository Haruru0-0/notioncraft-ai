# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The same publishable key is read under two names
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection string (Drizzle)
DATABASE_URL=

# The assistant uses each person's own Gemini key, saved in Profile and stored encrypted.
# 64 hex characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every saved key unreadable, so people would have to add theirs again.
KEY_ENCRYPTION_SECRET=

# Optional shared fallback. Leave it unset in production so every user must add their own key.
GOOGLE_GENERATIVE_AI_API_KEY=
